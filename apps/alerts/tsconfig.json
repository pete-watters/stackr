{
  "extends": "@stackr/tsconfig-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Standard web-platform typings cover everything this Worker touches
    // (fetch, WebCrypto, atob/btoa). @cloudflare/workers-types is deliberately
    // not used: its SubtleCrypto signatures diverge from lib.dom and from the
    // Node runtime the unit tests run on.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"]
}
