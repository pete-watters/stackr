{
  "name": "stackr-alerts",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  // Every 5 minutes: re-read subscribed positions and push on band changes.
  // Cadence is bounded by the upstream free tiers (ADR 0016), not by Workers.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  // Secrets (set with `wrangler secret put`, per .dev.vars.example):
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, VAPID_PUBLIC_KEY,
  //   VAPID_PRIVATE_KEY, and optionally VAPID_SUBJECT + HIRO_API_KEY.
}
