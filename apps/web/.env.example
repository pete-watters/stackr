# Analytics / observability (PostHog) — optional; the app runs without these.
# Create a free PostHog project, then set the key here for local dev and as a
# build-time secret in CI (Next inlines NEXT_PUBLIC_* at build time).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stackr Link pairing relay (Supabase Realtime broadcast) — optional; the
# "Stackr Wallet" pairing option is hidden without these. The anon key is
# public by design; pairing traffic is end-to-end encrypted client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
