# Analytics / observability (PostHog) — optional; the app runs without these.
# Create a free PostHog project, then set the key here for local dev and as a
# build-time secret in CI (Next inlines NEXT_PUBLIC_* at build time).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Accounts + liquidation alerts + Stackr Link pairing (Supabase) — optional; the
# app runs without these: auth surfaces show "not configured" and the
# "Stackr Wallet" pairing option stays hidden. Both values are public by
# design: the anon key only grants what row-level security allows, and pairing
# traffic is end-to-end encrypted client-side. The service-role key must NEVER
# be set here or anywhere client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VAPID public key for web-push alerts (the private half lives only in the
# alerts Worker's secrets). Generate a pair once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
