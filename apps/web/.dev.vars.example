# Local secrets for `wrangler` / OpenNext dev, consumed by the Solana RPC proxy
# at apps/web/src/app/api/rpc/solana/route.ts.
#
# Setup:
#   1. Copy this file to `.dev.vars` (already gitignored) in apps/web/.
#   2. Replace the placeholder with a real Helius key for local development.
#   3. For deployed environments, provision the secret instead of committing it:
#        wrangler secret put HELIUS_API_KEY
#
# This is a SERVER-ONLY secret: note the absence of a NEXT_PUBLIC_ prefix, so it
# is never inlined into the client bundle. When it is absent, the proxy falls
# back to the public mainnet-beta cluster and the app still works.
HELIUS_API_KEY=your-helius-key-here
