# Fastfile — Stackr mobile CD (Capacitor wrap, watch-only).
#
# Two platforms, one lane each for the everyday release plus a deliver lane for
# App Store metadata. Every lane assumes the static web export is already built
# (`NEXT_PUBLIC_TARGET=capacitor pnpm --filter @stackr/web build:mobile`) and
# synced into the native project (`npx cap sync`). The mobile-release.yml GitHub
# Actions workflow does that wiring; locally you run those two commands first.
#
# The native ios/ and android/ projects are generated by `npx cap add` (an owner
# step on a Mac) and are not committed. Each lane no-ops with a clear message if
# its platform folder is missing, so `fastlane ios beta` / `fastlane android
# internal` are safe to run before the projects exist.
#
# Auth is an App Store Connect API key (App Store / TestFlight) and a Google Play
# service-account JSON (Play) — never an Apple ID password. All credentials come
# from environment variables / CI secrets; nothing is committed. See
# docs/mobile-release.md for the secret names and the one-time owner setup.

# Paths resolve relative to this fastlane/ directory (apps/web/fastlane).
ios_project_dir = File.expand_path('../ios', __dir__)
android_project_dir = File.expand_path('../android', __dir__)

# Workspace + scheme that `npx cap add ios` scaffolds for a Capacitor app.
ios_workspace = File.join(ios_project_dir, 'App', 'App.xcworkspace')
ios_scheme = 'App'

# Shared JWT auth for pilot/deliver/match. key_content holds the .p8 body, passed
# base64-encoded through APP_STORE_CONNECT_API_KEY_CONTENT in CI.
def authenticate_app_store_connect
  app_store_connect_api_key(
    key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ID'),
    issuer_id: ENV.fetch('APP_STORE_CONNECT_API_ISSUER_ID'),
    key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_CONTENT'),
    is_key_content_base64: true,
  )
end

platform :ios do
  desc 'Build the Capacitor iOS app and upload it to TestFlight (pilot).'
  lane :beta do
    unless File.directory?(ios_project_dir)
      UI.important('No apps/web/ios project found.')
      UI.important('Run `npx cap add ios` on a Mac first (owner step) — skipping iOS beta lane.')
      next
    end

    authenticate_app_store_connect

    # Signing assets via match (read-only in CI). Needs MATCH_GIT_URL +
    # MATCH_PASSWORD; if unset we fall through to manually installed signing
    # assets on the build machine. See Matchfile + docs/mobile-release.md.
    if ENV['MATCH_GIT_URL']
      match(type: 'appstore', readonly: true)
    else
      UI.message('MATCH_GIT_URL unset — relying on manually installed signing assets.')
    end

    build_app(
      workspace: ios_workspace,
      scheme: ios_scheme,
      export_method: 'app-store',
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc 'Push App Store metadata/screenshots and submit for review (deliver).'
  lane :release do
    unless File.directory?(ios_project_dir)
      UI.important('No apps/web/ios project found — run `npx cap add ios` first. Skipping iOS release lane.')
      next
    end

    authenticate_app_store_connect

    # Metadata only by default; binaries ship through the beta lane (pilot).
    upload_to_app_store(
      skip_binary_upload: true,
      precheck_include_in_app_purchases: false,
    )
  end
end

platform :android do
  desc 'Build the Capacitor Android app bundle and upload it to a Play track (supply).'
  lane :internal do |options|
    unless File.directory?(android_project_dir)
      UI.important('No apps/web/android project found.')
      UI.important('Run `npx cap add android` first (owner step) — skipping Android lane.')
      next
    end

    track = options[:track] || 'internal'

    # Release AAB. The keystore is wired by the owner into android/app's Gradle
    # signingConfig from ANDROID_* secrets (see docs) — no keystore lives here.
    gradle(
      task: 'bundle',
      build_type: 'Release',
      project_dir: android_project_dir,
    )

    # supply → Play. json_key_data holds PLAY_SERVICE_ACCOUNT_JSON in CI; uploaded
    # as a draft so the owner reviews before rolling out.
    upload_to_play_store(
      track: track,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key_data: ENV['PLAY_SERVICE_ACCOUNT_JSON'],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft',
    )
  end
end
